    <string name="wisdom_title_ayah">Günün Ayet-i Kerimesi</string>
    <string name="wisdom_title_hadith">Günün Hadis-i Şerifi</string>
    <string name="wisdom_text_1">Şüphesiz namaz, müminler üzerine belirli vakitlerde farz kılınmıştır.</string>
    <string name="wisdom_source_1">Nisâ Suresi, 103. Ayet</string>
    <string name="wisdom_text_2">Allah katında amellerin en sevimlisi, vaktinde kılınan namazdır.</string>
    <string name="wisdom_source_2">Buhârî, Mevâkît 5; Müslim, Îmân 137</string>
    <string name="wisdom_text_3">Gündüzün iki ucunda ve gecenin gündüze yakın zamanlarında namaz kıl. Muhakkak ki iyilikler kötülükleri yok eder.</string>
    <string name="wisdom_source_3">Hûd Suresi, 114. Ayet</string>
    <string name="wisdom_text_4">Cennetin anahtarı namaz, namazın anahtarı ise abdesttir.</string>
    <string name="wisdom_source_4">Tirmizî, Tahâret 1</string>
    <string name="wisdom_text_5">Bilesiniz ki, kalpler ancak Allah\'ı anmakla huzur bulur.</string>
    <string name="wisdom_source_5">Ra\'d Suresi, 28. Ayet</string>
    <string name="wisdom_text_6">Büyük günahlardan kaçınıldığı müddetçe, beş vakit namaz aralarındaki günahlara kefarettir.</string>
    <string name="wisdom_source_6">Müslim, Tahâret 16</string>
    <string name="wisdom_text_7">Sabır ve namazla Allah\'tan yardım isteyin. Şüphesiz namaz, Allah\'a saygı duyanlardan başkasına ağır gelir.</string>
    <string name="wisdom_source_7">Bakara Suresi, 45. Ayet</string>

